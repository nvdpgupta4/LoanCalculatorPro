{
  "name": "loancalculatorpro",
  "version": "1.0.0",
  "private": true,
  "description": "LoanCalc Pro — EMI, part-payment and bank-comparison calculator for Indian loans",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "verify:examples": "node --env-file-if-exists=.env.local --import tsx scripts/verify-examples.ts",
    "gen:secret": "node scripts/gen-secret.mjs",
    "gen:hash": "node scripts/gen-hash.mjs",
    "db:guides": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/add-guides.ts",
    "guide:figures": "node --import tsx scripts/guide-figures.ts",
    "verify:investment": "node --import tsx scripts/verify-investment.ts",
    "db:scheme-rates": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed-scheme-rates.ts",
    "guide:investment-figures": "node --import tsx scripts/investment-guide-figures.ts",
    "db:investment-guides": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/add-investment-guides.ts",
    "db:seed:prod": "node --conditions=react-server --env-file=.env.prod.local --import tsx scripts/seed.ts",
    "db:guides:prod": "node --conditions=react-server --env-file=.env.prod.local --import tsx scripts/add-guides.ts",
    "db:scheme-rates:prod": "node --conditions=react-server --env-file=.env.prod.local --import tsx scripts/seed-scheme-rates.ts",
    "db:investment-guides:prod": "node --conditions=react-server --env-file=.env.prod.local --import tsx scripts/add-investment-guides.ts",
    "verify:sw": "node --import tsx scripts/verify-sw.ts",
    "gen:favicon": "node --import tsx scripts/make-favicon.tsx",
    "verify:countries": "node --import tsx scripts/verify-countries.ts",
    "db:migrate:country": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/migrate-country.ts",
    "db:migrate:country:prod": "node --conditions=react-server --env-file=.env.prod.local --import tsx scripts/migrate-country.ts",
    "db:author": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/set-author.ts",
    "db:author:prod": "node --conditions=react-server --env-file=.env.prod.local --import tsx scripts/set-author.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "marked": "^18.0.11",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
